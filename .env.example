# --- Base de datos ---
# Host: 127.0.0.1 si la API corre en el host; Docker Compose (servicio api) usa mysql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=test_db
DB_USER=app
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=rootchangeme
# true solo en local cuando cambias modelos. Nunca en production.
# sync() sin alter igual CREA tablas nuevas si no existen.
DB_SYNC_ALTER=false

# --- API ---
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200
# Swagger: en development está activo. En production hay que poner true.
ENABLE_DOCS=true
# Detrás de un reverse proxy: 1 (un hop). No lo pongas si Node escucha en internet directo.
# TRUST_PROXY=1

JWT_SECRET=replace-with-at-least-32-random-characters
AUTH=replace-with-at-least-16-random-characters
# Distinto de JWT_SECRET. Firma URLs de /media si se reactivan uploads.
MEDIA_HMAC_SECRET=replace-with-another-32-random-characters

SEED_ADMIN_EMAIL=admin@jrtech.com
SEED_ADMIN_PASSWORD=replace-with-letters-and-numbers-8plus
# Días para anonimizar invitados de reservas canceladas/expiradas. 0 desactiva el job.
PII_RETENTION_DAYS=90
SEED_USER_EMAIL=user@jrtech.com
SEED_USER_PASSWORD=replace-with-strong-password

MEDIA_URL_TTL_SECONDS=3600

# --- Correo SMTP ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=

# --- Archivos ---
BACKEND_URL_UPLOADS=/uploads/
